+void EngineGeneration::startIdleTrim() {
+	if (this->idleTrimTimer != nullptr || this->engine == nullptr) return;
+
+	this->idleTrimTimer = new QTimer(this);
+	this->idleTrimTimer->setInterval(45000);
+	QObject::connect(this->idleTrimTimer, &QTimer::timeout, this, &EngineGeneration::trimCaches);
+	this->idleTrimTimer->start();
+}
+
+void EngineGeneration::trimCaches() {
+	if (this->engine == nullptr || this->destroying) return;
+
+	this->engine->trimComponentCache();
+	this->engine->collectGarbage();
+
+	for (auto* window: this->trackedWindows) {
+		if (window != nullptr && !window->isVisible()) {
+			window->releaseResources();
+		}
+	}
+}
