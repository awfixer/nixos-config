{
  "toolchains": {
    "node": {
      "use": "bun",
      "reason": "Run JavaScript and TypeScript with `bun` (TypeScript is native; no tsx/ts-node)."
    },
    "nodejs": {
      "use": "bun",
      "reason": "Run JavaScript and TypeScript with `bun`."
    },
    "npm": {
      "use": "bun",
      "reason": "Use the Bun CLI instead of npm (`bun install`, `bun add`, `bun run`, `bun test`, `bunx`).",
      "map": {
        "init": "bun init",
        "create": "bun create",
        "install": "bun install",
        "i": "bun install",
        "ci": "bun install --frozen-lockfile",
        "add": "bun add",
        "remove": "bun remove",
        "rm": "bun remove",
        "uninstall": "bun remove",
        "update": "bun update",
        "outdated": "bun outdated",
        "run": "bun run",
        "test": "bun test",
        "exec": "bunx",
        "x": "bunx",
        "dlx": "bunx",
        "npx": "bunx",
        "publish": "bun publish",
        "pack": "bun pm pack",
        "link": "bun link",
        "unlink": "bun unlink",
        "audit": "bun audit",
        "why": "bun why"
      }
    },
    "npx": {
      "use": "bunx",
      "reason": "Use `bunx` instead of `npx`."
    },
    "pnpm": {
      "use": "bun",
      "reason": "Use the Bun CLI instead of pnpm (`bun install`, `bun add`, `bun run`, `bunx`).",
      "map": {
        "init": "bun init",
        "create": "bun create",
        "install": "bun install",
        "i": "bun install",
        "add": "bun add",
        "remove": "bun remove",
        "rm": "bun remove",
        "update": "bun update",
        "outdated": "bun outdated",
        "run": "bun run",
        "test": "bun test",
        "exec": "bunx",
        "dlx": "bunx",
        "publish": "bun publish"
      }
    },
    "pnpx": {
      "use": "bunx",
      "reason": "Use `bunx` instead of `pnpx`."
    },
    "yarn": {
      "use": "bun",
      "reason": "Use the Bun CLI instead of Yarn (`bun install`, `bun add`, `bun run`, `bunx`).",
      "map": {
        "init": "bun init",
        "create": "bun create",
        "install": "bun install",
        "add": "bun add",
        "remove": "bun remove",
        "upgrade": "bun update",
        "run": "bun run",
        "test": "bun test",
        "dlx": "bunx",
        "exec": "bunx",
        "publish": "bun publish"
      }
    },
    "yarnpkg": {
      "use": "bun",
      "reason": "Use the Bun CLI instead of Yarn."
    },
    "corepack": {
      "use": "bun",
      "reason": "Do not enable npm/pnpm/yarn via corepack. Use Bun."
    },
    "tsx": {
      "use": "bun",
      "reason": "Bun runs TypeScript directly: `bun file.ts` (or `bun --watch file.ts`)."
    },
    "ts-node": {
      "use": "bun",
      "reason": "Bun runs TypeScript directly: `bun file.ts`."
    },
    "ts-node-esm": {
      "use": "bun",
      "reason": "Bun runs TypeScript directly: `bun file.ts`."
    },
    "nodemon": {
      "use": "bun --watch",
      "reason": "Use `bun --watch` or `bun --hot` instead of nodemon."
    },
    "deno": {
      "use": "bun",
      "reason": "This plugin requires Bun, not Deno."
    }
  },
  "packages": {
    "ws": {
      "use": "`new WebSocket()` (client) or `Bun.serve({ websocket })` (server)",
      "docs": "https://bun.com/docs/runtime/http/websockets",
      "aliases": ["@types/ws"]
    },
    "sharp": {
      "use": "`Bun.Image` (chainable decode/resize/encode; Sharp-shaped API)",
      "docs": "https://bun.com/docs/runtime/image",
      "aliases": ["@img/sharp-linux-x64", "@img/sharp-linuxmusl-x64"]
    },
    "better-sqlite3": {
      "use": "`import { Database } from \"bun:sqlite\"`",
      "docs": "https://bun.com/docs/runtime/sqlite",
      "aliases": ["@types/better-sqlite3"]
    },
    "sqlite3": {
      "use": "`import { Database } from \"bun:sqlite\"`",
      "docs": "https://bun.com/docs/runtime/sqlite",
      "aliases": ["@types/sqlite3"]
    },
    "pg": {
      "use": "`import { sql } from \"bun\"` (`Bun.SQL`)",
      "docs": "https://bun.com/docs/runtime/sql",
      "aliases": ["postgres", "postgresql", "@types/pg"]
    },
    "mysql2": {
      "use": "`new SQL(\"mysql://…\")` (`Bun.SQL`)",
      "docs": "https://bun.com/docs/runtime/sql",
      "aliases": ["mysql", "@types/mysql"]
    },
    "ioredis": {
      "use": "`import { redis } from \"bun\"` (`Bun.redis` / `RedisClient`)",
      "docs": "https://bun.com/docs/runtime/redis",
      "aliases": ["redis"]
    },
    "js-yaml": {
      "use": "`Bun.YAML.parse` or `import data from \"./file.yaml\"`",
      "docs": "https://bun.com/docs/runtime/yaml",
      "aliases": ["yaml"]
    },
    "glob": {
      "use": "`import { Glob } from \"bun\"`",
      "docs": "https://bun.com/docs/runtime/glob",
      "aliases": ["fast-glob", "globby", "tinyglobby", "micromatch"]
    },
    "semver": {
      "use": "`Bun.semver` (`satisfies`, `order`)",
      "docs": "https://bun.com/docs/runtime/semver"
    },
    "color": {
      "use": "`Bun.color(input, format)`",
      "docs": "https://bun.com/docs/runtime/color",
      "aliases": ["tinycolor2", "tinycolor"]
    },
    "dotenv": {
      "use": "Bun auto-loads `.env*` into `process.env` / `Bun.env`",
      "docs": "https://bun.com/docs/runtime/environment-variables",
      "aliases": ["dotenv-expand", "dotenv-cli"]
    },
    "node-fetch": {
      "use": "global `fetch`",
      "docs": "https://bun.com/docs/runtime/networking/fetch",
      "aliases": ["undici", "isomorphic-fetch", "cross-fetch", "whatwg-fetch"]
    },
    "tsx": {
      "use": "`bun file.ts` (TypeScript is native)",
      "docs": "https://bun.com/docs/typescript"
    },
    "ts-node": {
      "use": "`bun file.ts` (TypeScript is native)",
      "docs": "https://bun.com/docs/typescript",
      "aliases": ["ts-node-esm", "esbuild-register", "@swc-node/register"]
    },
    "nodemon": {
      "use": "`bun --watch` or `bun --hot`",
      "docs": "https://bun.com/docs/runtime/watch-mode"
    },
    "bcrypt": {
      "use": "`Bun.password.hash` / `Bun.password.verify` (`algorithm: \"bcrypt\"`)",
      "docs": "https://bun.com/docs/runtime/hashing",
      "aliases": ["bcryptjs", "argon2", "argon2id"]
    },
    "uuid": {
      "use": "`crypto.randomUUID()` or `Bun.randomUUIDv7()`",
      "docs": "https://bun.com/docs/runtime/utils",
      "aliases": ["@types/uuid"]
    },
    "which": {
      "use": "`Bun.which(name)`",
      "docs": "https://bun.com/docs/runtime/utils"
    },
    "wrap-ansi": {
      "use": "Bun's wrap-ansi-compatible helper (`Bun.stringWidth` / docs utils)",
      "docs": "https://bun.com/docs/runtime/utils"
    },
    "json5": {
      "use": "import JSON5 files directly, or Bun's JSON5 parser",
      "docs": "https://bun.com/docs/runtime/json5"
    },
    "toml": {
      "use": "`Bun.TOML.parse` or `import data from \"./file.toml\"`",
      "docs": "https://bun.com/docs/runtime/toml",
      "aliases": ["@iarna/toml", "smol-toml"]
    },
    "fast-xml-parser": {
      "use": "`Bun.XML`",
      "docs": "https://bun.com/docs/runtime/xml",
      "aliases": ["xml2js", "@types/xml2js"]
    },
    "cookie": {
      "use": "`Bun.Cookie` / `Bun.CookieMap`",
      "docs": "https://bun.com/docs/runtime/cookies",
      "aliases": ["cookie-parser"]
    },
    "csrf": {
      "use": "`Bun.CSRF.generate` / `Bun.CSRF.verify`",
      "docs": "https://bun.com/docs/runtime/csrf",
      "aliases": ["csurf", "csrf-csrf"]
    },
    "tar": {
      "use": "`Bun.Archive`",
      "docs": "https://bun.com/docs/runtime/archive",
      "aliases": ["node-tar", "tar-stream", "tar-fs"]
    },
    "execa": {
      "use": "`Bun.spawn` / `Bun.$` (bun shell)",
      "docs": "https://bun.com/docs/runtime/child-process",
      "aliases": ["zx"]
    },
    "cross-env": {
      "use": "`FOO=bar bun run …` or bun shell (`bun exec`)",
      "docs": "https://bun.com/docs/runtime/environment-variables"
    },
    "rimraf": {
      "use": "`rm -rf` or `` await $`rm -rf dir` ``",
      "docs": "https://bun.com/docs/runtime/shell",
      "aliases": ["del"]
    }
  }
}
